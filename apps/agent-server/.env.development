# 开发环境配置：本地调试使用
# 加载方式：pnpm --filter @repo/agent-server run dev 时由 tsx 通过 --env-file 注入
# 已存在的系统环境变量优先级高于本文件，可临时覆盖某项配置

NODE_ENV=development
PORT=3000

# 数据目录：默认取进程工作目录下的 data，如需自定义请填写绝对路径
# DATA_DIR=

# 日志：级别 debug / info / warn / error，开发环境打开 debug 可看到工具调用细节
LOG_LEVEL=debug
# 日志目录：留空时写入 <数据目录>/logs，如需自定义请填写绝对路径
# LOG_DIR=
# 日志文件保留天数：按天轮转，超期文件在启动与跨天时清理
LOG_RETENTION_DAYS=14

# PostgreSQL：关系库与向量库共用同一实例（见 docs/adr/0012 阶段 2），后端首次启动会自动建库建表
PG_HOST=127.0.0.1
PG_PORT=5432
PG_USER=postgres
# 真实密码请勿写进本文件：本地用系统环境变量 PG_PASSWORD 覆盖（如容器默认 postgres）
PG_PASSWORD=postgres
# 库需预建并执行过 CREATE EXTENSION vector；未启用扩展时连接能通、建表会失败
PG_DATABASE=postgres
# 连接池上限与建连超时（毫秒）：关系库走短查询，池子不必大
PG_POOL_MAX=10
PG_CONNECT_TIMEOUT_MS=10000
# 池满快速失败：等待队列长度上限（0 表示不排队）。pg 池无此语义，由应用层在入池前据此拒绝
PG_QUEUE_LIMIT=32

# 知识库向量：固定走上面这份 PostgreSQL 实例的 pgvector 扩展（见 docs/adr/0012），无独立开关

# 初始超管：库里没有任何后台侧账号时据此自举一枚，留空则跳过并在启动日志告警
# 本地调试需要进管理后台时，用系统环境变量覆盖这两项，不要把真实口令写进本文件
INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_PASSWORD=

# 对话模型：开发默认走本地 Ollama，无需外网与密钥
LLM_PROVIDER=ollama
LLM_TEMPERATURE=0.3
# 推理链（thinking）：开启后模型先输出思考过程再作答，需换用支持 thinking 的模型
# （如 qwen3、gpt-oss）；qwen3 支持 thinking，开启后行为与耗时都会变化，默认关闭
LLM_THINKING=true
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=qwen3
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
# 视觉模型：图片附件由它转述成文字后交给对话模型；留空即关闭图片理解
OLLAMA_VISION_MODEL=qwen3-vl:8b

# 对话模型：把 LLM_PROVIDER 改为 deepseek 后生效
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_CHAT_MODEL=deepseek-chat

# 上下文治理：历史超出窗口预算时丢弃最老的轮次，单轮工具结果超额度即截断
# 窗口预算按 provider 取对应项：本地 Ollama 的值需与 num_ctx 对齐，配大了会估不准
OLLAMA_CONTEXT_WINDOW_TOKENS=8192
DEEPSEEK_CONTEXT_WINDOW_TOKENS=65536
# 窗口占用超过该比例即触发裁剪，裁到下面这个占比的窗口
CONTEXT_TRIGGER_RATIO=0.7
CONTEXT_KEEP_RATIO=0.4
# 单轮检索 / 读取结果合计可注入的窗口占比，防止反复检索或读文件把窗口挤爆
CONTEXT_TOOL_RATIO=0.3

# 向量化：开发复用本地 Ollama
EMBEDDING_PROVIDER=ollama
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small

# 知识库切分与检索参数
KNOWLEDGE_CHUNK_SIZE=500
KNOWLEDGE_CHUNK_OVERLAP=80
KNOWLEDGE_TOP_K=4
KNOWLEDGE_MIN_SCORE=0.6

# 全局知识库管理令牌：留空表示不开放全局文档写入接口
KNOWLEDGE_ADMIN_TOKEN=

# 文件上传：multipart 不经过 express.json，体积上限必须在此单独声明
UPLOAD_MAX_BYTES=20971520
UPLOAD_MAX_FILES=1
# 允许的扩展名白名单：按文件头（magic bytes）判定后比对，不信任客户端给的扩展名
UPLOAD_ALLOWED_TYPES=docx,xlsx,pdf,png,jpg
# 上传目录：留空时写入 <数据目录>/uploads，如需自定义请填写绝对路径
# UPLOAD_DIR=

# HTTP 服务端超时与连接回收：防止半死连接永久占用连接与在途额度
HTTP_HEADERS_TIMEOUT_MS=20000
# 需覆盖大文件上传的接收耗时，故给到 2 分钟
HTTP_REQUEST_TIMEOUT_MS=120000
HTTP_KEEP_ALIVE_TIMEOUT_MS=65000
# 单条 keep-alive 连接可复用的最大请求数，0 表示不限
HTTP_MAX_REQUESTS_PER_SOCKET=1000

# 并发治理：按请求类型分三档闸门，配额互不挤占；软水位之上进有界队列，硬水位之上直接 503
# 每档四项：硬水位（在途上限）/ 软水位 / 队列长度上限 / 排队等待上限（毫秒）
# 默认值只保证不雪崩，吞吐基线须压测后校准；健康检查与登录接口不入闸门
# 对话流：占用长，档位按模型算力收得最紧
CONCURRENCY_CHAT_MAX_IN_FLIGHT=8
CONCURRENCY_CHAT_SOFT_LIMIT=6
CONCURRENCY_CHAT_QUEUE_LIMIT=32
CONCURRENCY_CHAT_QUEUE_TIMEOUT_MS=20000
# 上传解析：CPU 密集且会阻塞事件循环，档位最紧
CONCURRENCY_UPLOAD_MAX_IN_FLIGHT=2
CONCURRENCY_UPLOAD_SOFT_LIMIT=1
CONCURRENCY_UPLOAD_QUEUE_LIMIT=8
CONCURRENCY_UPLOAD_QUEUE_TIMEOUT_MS=10000
# 普通读写：会话 / 文件 / 知识库 / 管理端，查询轻但往返多
CONCURRENCY_CRUD_MAX_IN_FLIGHT=32
CONCURRENCY_CRUD_SOFT_LIMIT=24
CONCURRENCY_CRUD_QUEUE_LIMIT=64
CONCURRENCY_CRUD_QUEUE_TIMEOUT_MS=5000
# 单轮对话最长时长：到点中断本轮并按已产出收尾，防止半死连接永久占住额度
CHAT_MAX_DURATION_MS=180000
# SSE 背压：写缓冲满后等待 drain 的上限，超时按慢客户端退订（本轮生成继续在后台跑完）
SSE_DRAIN_TIMEOUT_MS=30000
# 断点续传：已收尾轮次的事件日志保留时长（毫秒），期间客户端可凭序号重连补齐
SSE_ROUND_TTL_MS=60000
# 断点续传：允许同时后台续生成的轮次上限，超出即中止最老一轮
SSE_DETACHED_MAX_ROUNDS=16
# 断点续传：单轮事件日志保留的帧数上限，超出即丢弃最老帧（重放窗口右移）
SSE_REPLAY_MAX_EVENTS=2000
# 优雅停机：停止接单后等待在途请求收尾的上限
SHUTDOWN_GRACE_MS=15000

# 单轮瘦身（P1）：降低每轮基线占用，让上面的闸门阈值可以定得更宽（见 docs/adr/0010 决策 13）
# 接口请求日志批量刷写：攒够 batchSize 条立即写，否则按 flushIntervalMs 定时写；停机时会落尽
API_LOG_BATCH_SIZE=10
API_LOG_FLUSH_INTERVAL_MS=5000
# 鉴权会话缓存：令牌校验结果缓存这么久（毫秒），登出 / 重新登录 / 删号会主动失效
AUTH_SESSION_CACHE_TTL_MS=5000

# 模型与依赖治理（P2）：模型侧闸门按 provider 分档，摘要走独立低优先队列，检索独立小并发并带熔断
# 阈值全部收敛于 env.ts 一处，见 docs/adr/0010 决策 9 / 10 / 11 / 16
# 模型闸门：真实瓶颈在模型算力，与入口 HTTP 档分开计量；默认 Ollama 1~2、DeepSeek 放宽
CONCURRENCY_MODEL_MAX_IN_FLIGHT=2
CONCURRENCY_MODEL_SOFT_LIMIT=1
CONCURRENCY_MODEL_QUEUE_LIMIT=8
CONCURRENCY_MODEL_QUEUE_TIMEOUT_MS=20000
# 摘要闸门：并发 1 且不排队，满即拒绝，由治理层退化为丢弃最老历史，不拖慢首 token
CONCURRENCY_SUMMARY_MAX_IN_FLIGHT=1
CONCURRENCY_SUMMARY_SOFT_LIMIT=1
CONCURRENCY_SUMMARY_QUEUE_LIMIT=0
CONCURRENCY_SUMMARY_QUEUE_TIMEOUT_MS=3000
# 检索闸门：独立小并发，检索缺失只影响本轮答案质量，不阻断对话
CONCURRENCY_RETRIEVAL_MAX_IN_FLIGHT=4
CONCURRENCY_RETRIEVAL_SOFT_LIMIT=2
CONCURRENCY_RETRIEVAL_QUEUE_LIMIT=8
CONCURRENCY_RETRIEVAL_QUEUE_TIMEOUT_MS=3000
# 单次检索（含向量化）超时：超时降级为「本轮无知识库结果」，写入路径不降级、如实报错
RETRIEVAL_TIMEOUT_MS=8000
# 依赖熔断：连续失败达该值即快速失败，冷却到点后再放一个探测（半开）
CIRCUIT_FAILURE_THRESHOLD=5
CIRCUIT_COOLDOWN_MS=30000

# 事件循环与上传保护（P3）：附件解析是主线程 CPU 密集计算，单独入最小额度的闸门（见 docs/adr/0010 决策 14）
# 附件解析闸门：docx / xlsx / pdf 解析独占小额度，排队只为削峰；过载时读路径降级为「读取失败」
CONCURRENCY_PARSE_MAX_IN_FLIGHT=2
CONCURRENCY_PARSE_SOFT_LIMIT=1
CONCURRENCY_PARSE_QUEUE_LIMIT=8
CONCURRENCY_PARSE_QUEUE_TIMEOUT_MS=5000

# 观测与验收（P4）：指标埋点与分级就绪检查（见 docs/adr/0010 决策 17）
# 事件循环延迟采样间隔：越短越能捕捉短时阻塞（如附件解析卡主线程），开销也越大
OBSERVABILITY_EVENT_LOOP_SAMPLE_INTERVAL_MS=10000
# 直方图保留的最近样本数：池等待 / 分段耗时等分位数基于该窗口计算，长跑下内存仍有上界
OBSERVABILITY_HISTOGRAM_SIZE=1024
# 就绪检查 /api/health/ready 探测单个依赖（PostgreSQL / 模型 / 向量服务）的超时
READINESS_PROBE_TIMEOUT_MS=3000
