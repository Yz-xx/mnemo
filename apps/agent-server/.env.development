# 开发环境配置：本地调试使用
# 加载方式：pnpm --filter @repo/agent-server run dev 时由 tsx 通过 --env-file 注入
# 已存在的系统环境变量优先级高于本文件，可临时覆盖某项配置

NODE_ENV=development
PORT=3000

# 数据目录：默认取进程工作目录下的 data，如需自定义请填写绝对路径
# DATA_DIR=

# 日志：级别 debug / info / warn / error，开发环境打开 debug 可看到工具调用细节
LOG_LEVEL=debug
# 日志目录：留空时写入 <数据目录>/logs，如需自定义请填写绝对路径
# LOG_DIR=
# 日志文件保留天数：按天轮转，超期文件在启动与跨天时清理
LOG_RETENTION_DAYS=14

# MySQL：本地开发库，后端首次启动会自动建库建表
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=123456
MYSQL_DATABASE=agent_data

# 对话模型：开发默认走本地 Ollama，无需外网与密钥
LLM_PROVIDER=ollama
LLM_TEMPERATURE=0.3
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=qwen2.5:7b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# 对话模型：把 LLM_PROVIDER 改为 deepseek 后生效
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_CHAT_MODEL=deepseek-chat

# 向量化：开发复用本地 Ollama
EMBEDDING_PROVIDER=ollama
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small

# 知识库切分与检索参数
KNOWLEDGE_CHUNK_SIZE=500
KNOWLEDGE_CHUNK_OVERLAP=80
KNOWLEDGE_TOP_K=4
KNOWLEDGE_MIN_SCORE=0.6

# 全局知识库管理令牌：留空表示不开放全局文档写入接口
KNOWLEDGE_ADMIN_TOKEN=
