{
  "name": "@repo/agent-server",
  "version": "0.0.0",
  "private": true,
  "description": "后端应用（Express + LangChain 智能体服务）",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env.development src/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "node --env-file=.env.production dist/index.js",
    "test": "vitest run",
    "mock:model": "tsx scripts/mockModel.ts",
    "bench": "tsx scripts/bench.ts"
  },
  "dependencies": {
    "@lancedb/lancedb": "^0.39.0",
    "@langchain/core": "^1.2.12",
    "@langchain/ollama": "^1.3.0",
    "@langchain/openai": "^1.5.13",
    "@langchain/textsplitters": "^1.0.1",
    "@pdf-lib/fontkit": "^1.1.1",
    "@repo/logger": "workspace:*",
    "@repo/reusable": "workspace:*",
    "@repo/shared": "workspace:*",
    "apache-arrow": "^18.1.0",
    "docx": "^9.7.2",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "file-type": "^22.1.1",
    "langchain": "^1.5.11",
    "mammoth": "^1.12.3",
    "multer": "^2.4.0",
    "mysql2": "^3.24.4",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "tsx": "^4.23.13",
    "vitest": "^3.2.7"
  }
}
