# 生产环境配置：服务器部署 / 打包分发使用
# 加载方式：pnpm --filter @repo/agent-server run start 时由 node 通过 --env-file 注入
# 敏感项（数据库密码、API Key）请勿提交真实值，在部署机器上以系统环境变量覆盖

NODE_ENV=production
PORT=3000

# 数据目录：默认取进程工作目录下的 data，如需自定义请填写绝对路径
# DATA_DIR=

# 日志：级别 debug / info / warn / error，生产保持 info，排查期可临时调为 debug
LOG_LEVEL=info
# 日志目录：留空时写入 <数据目录>/logs，如需自定义请填写绝对路径
# LOG_DIR=
# 日志文件保留天数：按天轮转，超期文件在启动与跨天时清理
LOG_RETENTION_DAYS=14

# MySQL：生产库，后端首次启动会自动建库建表
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=CHANGE_ME
MYSQL_DATABASE=agent_data
# 池满快速失败：池满后的等待队列长度上限（0 表示不排队），以及建连超时（毫秒）
MYSQL_QUEUE_LIMIT=32
MYSQL_CONNECT_TIMEOUT_MS=10000

# 初始超管：库里没有任何后台侧账号时据此自举一枚，留空则跳过并在启动日志告警
# 上线前必须先配好这两项再上代码，否则新库启动后没有任何账号能进管理后台
INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_PASSWORD=

# 对话模型：生产走 DeepSeek 线上服务
LLM_PROVIDER=deepseek
LLM_TEMPERATURE=0.3
# 推理链（thinking）：仅对 Ollama 生效，DeepSeek 走 reasoner 模型时自带 reasoning_content
LLM_THINKING=false
DEEPSEEK_API_KEY=CHANGE_ME
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_CHAT_MODEL=deepseek-chat

# 本地 Ollama：作为线上服务不可用时的备选模型来源
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=qwen3
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
# 视觉模型：图片附件由它转述成文字后交给对话模型；留空即关闭图片理解
OLLAMA_VISION_MODEL=qwen3-vl:8b

# 上下文治理：历史超出窗口预算时丢弃最老的轮次，单轮工具结果超额度即截断
# 窗口预算按 provider 取对应项：本地 Ollama 的值需与 num_ctx 对齐，配大了会估不准
OLLAMA_CONTEXT_WINDOW_TOKENS=8192
DEEPSEEK_CONTEXT_WINDOW_TOKENS=65536
# 窗口占用超过该比例即触发裁剪，裁到下面这个占比的窗口
CONTEXT_TRIGGER_RATIO=0.7
CONTEXT_KEEP_RATIO=0.4
# 单轮检索 / 读取结果合计可注入的窗口占比，防止反复检索或读文件把窗口挤爆
CONTEXT_TOOL_RATIO=0.3

# 向量化：DeepSeek 未提供 embedding 接口，需独立配置
EMBEDDING_PROVIDER=openai
EMBEDDING_API_KEY=CHANGE_ME
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small

# 知识库切分与检索参数
KNOWLEDGE_CHUNK_SIZE=500
KNOWLEDGE_CHUNK_OVERLAP=80
KNOWLEDGE_TOP_K=4
KNOWLEDGE_MIN_SCORE=0.6

# 全局知识库管理令牌：留空表示不开放全局文档写入接口，部署时以系统环境变量覆盖
KNOWLEDGE_ADMIN_TOKEN=CHANGE_ME

# 文件上传：multipart 不经过 express.json，体积上限必须在此单独声明
UPLOAD_MAX_BYTES=20971520
UPLOAD_MAX_FILES=1
# 允许的扩展名白名单：按文件头（magic bytes）判定后比对，不信任客户端给的扩展名
UPLOAD_ALLOWED_TYPES=docx,xlsx,pdf,png,jpg
# 上传目录：留空时写入 <数据目录>/uploads，如需自定义请填写绝对路径
# UPLOAD_DIR=

# HTTP 服务端超时与连接回收：防止半死连接永久占用连接与在途额度
HTTP_HEADERS_TIMEOUT_MS=20000
# 需覆盖大文件上传的接收耗时，故给到 2 分钟
HTTP_REQUEST_TIMEOUT_MS=120000
HTTP_KEEP_ALIVE_TIMEOUT_MS=65000
# 单条 keep-alive 连接可复用的最大请求数，0 表示不限
HTTP_MAX_REQUESTS_PER_SOCKET=1000

# 并发治理：按请求类型分三档闸门，配额互不挤占；软水位之上进有界队列，硬水位之上直接 503
# 每档四项：硬水位（在途上限）/ 软水位 / 队列长度上限 / 排队等待上限（毫秒）
# 默认值只保证不雪崩，吞吐基线须压测后校准；健康检查与登录接口不入闸门
# 对话流：占用长，档位按模型算力收得最紧
CONCURRENCY_CHAT_MAX_IN_FLIGHT=8
CONCURRENCY_CHAT_SOFT_LIMIT=6
CONCURRENCY_CHAT_QUEUE_LIMIT=32
CONCURRENCY_CHAT_QUEUE_TIMEOUT_MS=20000
# 上传解析：CPU 密集且会阻塞事件循环，档位最紧
CONCURRENCY_UPLOAD_MAX_IN_FLIGHT=2
CONCURRENCY_UPLOAD_SOFT_LIMIT=1
CONCURRENCY_UPLOAD_QUEUE_LIMIT=8
CONCURRENCY_UPLOAD_QUEUE_TIMEOUT_MS=10000
# 普通读写：会话 / 文件 / 知识库 / 管理端，查询轻但往返多
CONCURRENCY_CRUD_MAX_IN_FLIGHT=32
CONCURRENCY_CRUD_SOFT_LIMIT=24
CONCURRENCY_CRUD_QUEUE_LIMIT=64
CONCURRENCY_CRUD_QUEUE_TIMEOUT_MS=5000
# 单轮对话最长时长：到点中断本轮并按已产出收尾，防止半死连接永久占住额度
CHAT_MAX_DURATION_MS=180000
# SSE 背压：写缓冲满后等待 drain 的上限，超时按慢客户端断开
SSE_DRAIN_TIMEOUT_MS=30000
# 优雅停机：停止接单后等待在途请求收尾的上限
SHUTDOWN_GRACE_MS=15000
