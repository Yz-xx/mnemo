{
  // 测试专用配置：主 tsconfig 把 src/__vitest__ 排除在构建类型检查之外，
  // 编辑器（TS 服务）对「不属于任何项目」的文件会退化成推断项目、结论与命令行不一致，
  // 故单列一份给它，使测试文件也能被显式类型检查（pnpm exec tsc -p src/__vitest__）。
  // include / exclude 必须在此重写（继承来的路径是相对主配置目录解析的）
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "noEmit": true
  },
  "include": ["**/*.ts"],
  "exclude": []
}
