# 生产环境配置：服务器部署 / 打包分发使用
# 加载方式：pnpm --filter @repo/backend run start 时由 node 通过 --env-file 注入
# 敏感项（数据库密码、API Key）请勿提交真实值，在部署机器上以系统环境变量覆盖

NODE_ENV=production
PORT=3000

# 数据目录：默认取进程工作目录下的 data，如需自定义请填写绝对路径
# DATA_DIR=

# MySQL：生产库，后端首次启动会自动建库建表
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=CHANGE_ME
MYSQL_DATABASE=agent_data

# 对话模型：生产走 DeepSeek 线上服务
LLM_PROVIDER=deepseek
LLM_TEMPERATURE=0.3
DEEPSEEK_API_KEY=CHANGE_ME
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_CHAT_MODEL=deepseek-chat

# 本地 Ollama：作为线上服务不可用时的备选模型来源
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=qwen2.5:7b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# 向量化：DeepSeek 未提供 embedding 接口，需独立配置
EMBEDDING_PROVIDER=openai
EMBEDDING_API_KEY=CHANGE_ME
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small

# 知识库切分与检索参数
KNOWLEDGE_CHUNK_SIZE=500
KNOWLEDGE_CHUNK_OVERLAP=80
KNOWLEDGE_TOP_K=4
