{
  "name": "@repo/backend",
  "version": "0.0.0",
  "private": true,
  "description": "后端应用（Express + LangChain 智能体服务）",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env.development src/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "node --env-file=.env.production dist/index.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@langchain/core": "^1.2.12",
    "@langchain/ollama": "^1.3.0",
    "@langchain/openai": "^1.5.13",
    "@langchain/textsplitters": "^1.0.1",
    "@repo/shared": "workspace:*",
    "express": "^5.2.1",
    "langchain": "^1.5.11",
    "mysql2": "^3.24.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "tsx": "^4.23.13",
    "vitest": "^3.2.7"
  }
}
