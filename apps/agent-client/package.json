{
  "name": "@mnemo/agent-client",
  "version": "0.0.0",
  "private": true,
  "description": "桌面端应用（Electron + Vue 3 + TypeScript）",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "dist": "electron-vite build && cross-env ELECTRON_BUILDER_BINARIES_MIRROR=https://npmmirror.com/mirrors/electron-builder-binaries/ electron-builder --win",
    "postinstall": "cross-env ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/ node node_modules/electron/install.js"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.2.0",
    "cross-env": "^10.1.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "less": "^4.9.1",
    "vue": "^3.5.42",
    "vue-tsc": "^3.3.11"
  },
  "dependencies": {
    "@mnemo/reusable": "workspace:*",
    "@mnemo/shared": "workspace:*",
    "markdown-it": "^15.0.2"
  }
}
