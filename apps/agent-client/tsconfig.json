{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // 主进程需要 Node 类型，渲染进程的 DOM 类型由基础配置统一提供
    "types": ["node"],
    "noEmit": true,
    "paths": {
      "@renderer/*": ["./src/renderer/src/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "electron.vite.config.ts"],
  // 单元测试由 vitest 直接运行，不参与 vue-tsc 类型检查与构建产物
  "exclude": ["src/renderer/src/__vitest__"]
}
