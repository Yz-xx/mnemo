{
  "name": "@repo/logger",
  "version": "0.0.0",
  "private": true,
  "description": "Node 端结构化日志库（控制台 + 按天轮转文件输出）",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "test": "vitest run --passWithNoTests"
  }
}
